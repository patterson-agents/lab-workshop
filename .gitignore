# Font binaries — ground rule: no fonts committed. Licensing of self-hosted
# Proxima Nova is unconfirmed; fonts load via the Adobe Fonts kit or are
# restorable from the original handoff zip pending a license ruling.
*.woff2
*.woff
*.ttf

# claude.ai/design export artifact — not part of the deliverable.
.thumbnail

# Reference-only third-party/user-supplied material, excluded per this
# export's own AGENTS.md ("Do not edit uploads/") and duplicated
# (the .pptx) in the patterson-design-system bundle.
uploads/

# OS / editor noise
.DS_Store
*.swp

# Package-manager and build artifacts. The Pages workflow builds site/ with
# Astro/Starlight, regenerates site/src/content/docs/tutorial/ from the
# TutorialKit package, and composes site/dist plus the passthrough root
# artifacts into a deploy artifact — none of these intermediate outputs are
# tracked. site/bun.lock IS tracked (frozen install depends on it).
node_modules/
dist/
.astro/
site/dist/
_site/

# Generated by scripts/build-tutorial.ts on every run; re-run it to regenerate
# rather than hand-editing anything under here.
site/src/content/docs/tutorial/
